<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_cash_flow_report_wizard" model="ir.ui.view">
        <field name="name">cash.flow.report.wizard.form</field>
        <field name="model">primetech.cash.flow.report.wizard</field>
        <field name="arch" type="xml">

            <form string="Etat Journalier de Trésorerie">

                <sheet>

                    <group>

                        <group string="Période">
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>

                        <group string="Journaux">
                            <field name="journal_ids"
                                widget="many2many_tags"
                                options="{'no_create': True}"/>
                        </group>

                    </group>

                </sheet>

                <footer>

                    <button
                        name="action_preview_report"
                        type="object"
                        string="Voir"
                        class="btn-secondary"/>

                    <button
                        name="action_print_report"
                        type="object"
                        string="Imprimer"
                        class="btn-primary"/>

                    <button
                        string="Annuler"
                        special="cancel"/>

                </footer>

            </form>

        </field>
    </record>

    <record id="action_cash_flow_report_wizard" model="ir.actions.act_window">
        <field name="name">Etat Journalier de Trésorerie</field>
        <field name="res_model">primetech.cash.flow.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>