<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_receivable_report_wizard" model="ir.ui.view">
        <field name="name">receivable.report.wizard.form</field>
        <field name="model">primetech.receivable.report.wizard</field>

        <field name="arch" type="xml">
            <form string="Etat des Soldes Partenaires">

                <sheet>

                    <group>

                        <group string="Situation">
                            <field name="report_date"/>
                            <field name="company_id"/>
                        </group>

                        <group string="Partenaires">
                            <field name="partner_type"/>
                            <field name="partner_ids" widget="many2many_tags"/>
                        </group>

                    </group>

                    <group string="Options">

                        <field name="show_details"/>

                        <field name="show_overdue_only"/>

                        <field name="include_zero_balance"/>

                        <field name="commercial_partner_only"/>

                        <field name="sort_by"/>

                    </group>

                </sheet>

                <footer>
                    <button
                        name="action_preview_report"
                        type="object"
                        string="Voir"
                        class="btn-secondary"/>

                    <button
                        name="action_print_report"
                        type="object"
                        string="Imprimer"
                        class="btn-primary"/>

                    <button
                        string="Annuler"
                        special="cancel"/>

                </footer>

            </form>
        </field>

    </record>

    <record id="action_receivable_report_wizard" model="ir.actions.act_window">

        <field name="name">Etat des Soldes Partenaires</field>

        <field name="res_model">primetech.receivable.report.wizard</field>

        <field name="view_mode">form</field>

        <field name="target">new</field>

    </record>

</odoo>