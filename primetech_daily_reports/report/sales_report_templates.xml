<?xml version="1.0" encoding="utf-8"?>

<odoo>

        <template id="sales_report_template">

            <t t-call="web.html_container">

                <t t-call="web.external_layout">

                    <link rel="stylesheet"
                        href="/primetech_daily_reports/static/src/css/sales_report.css"/>

                        <span t-esc="print_date.strftime('%d/%m/%Y %H:%M:%S')"/>

                    <div class="page">

                        <div class="report-title">
                            ETAT PERIODIQUE DES VENTES
                        </div>

                        <table style="width:100%;" class="report-period">

                            <tr>

                                <td style="white-space: nowrap;">

                                    <strong>Période :</strong>

                                    <span t-esc="docs.date_from"/>

                                    au

                                    <span t-esc="docs.date_to"/>

                                    <span style="margin-left:30px;">

                                        <strong>Imprimé le :</strong>

                                        <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M:%S')"/>

                                    </span>

                                </td>

                            </tr>

                        </table>

                        <table class="summary-report">

                            <thead>

                                <tr style="font-weight:bold;">

                                    <th>Facture</th>
                                    <th>Date</th>
                                    <th>Client</th>
                                    <th>Vendeur</th>
                                    <th>Article</th>
                                    <th>Qté</th>
                                    <th>PU HT</th>

                                    <t t-if="show_discount">
                                        <th>Remise %</th>
                                    </t>

                                    <th>Total HT</th>
                                    <th>Total TTC</th>

                                </tr>

                            </thead>

                            <tbody>

                                <tr t-foreach="lines"
                                    t-as="line">

                                    <td>
                                        <span t-esc="line['order']"/>
                                    </td>

                                    <td>
                                        <span t-esc="line['date']"/>
                                    </td>

                                    <td>
                                        <span t-esc="line['customer']"/>
                                    </td>

                                    <td>
                                        <span t-esc="line['salesperson']"/>
                                    </td>

                                    <td>
                                        <span t-esc="line['product']"/>
                                    </td>

                                    <td class="summary-qty">
                                        <span t-esc="int(line['qty'])"/>
                                    </td>

                                    <td class="summary-money">
                                        <span t-esc="'{:,.0f}'.format(line['unit_price']).replace(',', ' ')"/>
                                    </td>

                                    <t t-if="show_discount">

                                        <td class="summary-qty">
                                            <span t-esc="line['discount']"/>
                                        </td>

                                    </t>

                                    <td class="summary-money">
                                        <span t-esc="'{:,.0f}'.format(line['total_ht']).replace(',', ' ')"/>
                                    </td>

                                    <td class="summary-money">
                                        <span t-esc="'{:,.0f}'.format(line['total_ttc']).replace(',', ' ')"/>
                                    </td>

                                </tr>

                            </tbody>

                        </table>

                        <div class="section-title">
                            RÉSUMÉ GÉNÉRAL
                        </div>

                        <table class="summary-table">

                            <tr>
                                <td class="summary-label">Nombre de commandes</td>
                                <td class="summary-value">
                                    <span t-esc="order_count"/>
                                </td>
                            </tr>

                            <tr>
                                <td class="summary-label">Nombre de clients</td>
                                <td class="summary-value">
                                    <span t-esc="seller_count"/>
                                </td>
                            </tr>

                            <tr>
                                <td class="summary-label">Nombre de vendeurs</td>
                                <td class="summary-value">
                                    <span t-esc="customer_count"/>
                                </td>
                            </tr>

                            <tr>
                                <td class="summary-label">Chiffre D'affaire Hors Taxes</td>
                                <td class="summary-value">
                                    <span t-esc="'{:,.0f} FCFA'.format(grand_total_ht).replace(',', ' ')"/>
                                </td>
                            </tr>

                            <tr>
                                <td class="summary-label">Chiffre D'affaire TTC</td>
                                <td class="summary-value">
                                    <span t-esc="'{:,.0f} FCFA'.format(grand_total_ttc).replace(',', ' ')"/>
                                </td>
                            </tr>

                        </table>

                        <div class="section-title"
                            style="margin-top:20px;
                                    margin-bottom:12px;
                                    font-size:16px;
                                    font-weight:bold;
                                    text-align:center;
                                    border-bottom:2px solid #000;
                                    padding-bottom:5px;">

                            SYNTHÈSE DES VENTES PAR VENDEUR ET PAR SEMAINE

                            <br/>

                            <span style="font-size:11px;font-weight:normal;">

                                Période du
                                <span t-esc="docs.date_from.strftime('%d/%m/%Y')"/>
                                au
                                <span t-esc="docs.date_to.strftime('%d/%m/%Y')"/>

                            </span>

                        </div>

                        <!-- KPI -->

                        <table style="
                            width:100%;
                            margin-bottom:15px;
                            border:1px solid #ddd;
                            ">

                            <tr>

                                <td style="text-align:center;">
                                    <strong>Chiffre d'Affaire</strong><br/>
                                    <span t-esc="'{:,.0f}'.format(grand_total_ttc).replace(',', ' ')"/>
                                    FCFA
                                </td>

                                <td style="text-align:center;">
                                    <strong>Commissions</strong><br/>
                                    <span t-esc="'{:,.0f}'.format(total_commission).replace(',', ' ')"/>
                                    FCFA
                                </td>

                                <td style="text-align:center;">
                                    <strong>Commandes</strong><br/>
                                    <span t-esc="order_count"/>
                                </td>

                                <td style="text-align:center;">
                                    <strong>Vendeurs</strong><br/>
                                    <span t-esc="seller_count"/>
                                </td>

                            </tr>

                        </table>

                        <!-- DISPOSITION PRINCIPALE -->

                        <table style="
                            width:100%;
                            border-collapse:collapse;
                            ">

                            <tr>

                                <!-- TABLEAU DETAIL -->

                                <td style="
                                    width:72%;
                                    vertical-align:top;
                                    padding-right:10px;
                                ">

                                    <table class="summary-report">

                                        <thead>

                                            <tr style="
                                                background:#e9ecef;
                                                font-weight:bold;
                                                font-size:12px;
                                                text-transform:uppercase;
                                            ">

                                                <th width="20%">Semaine</th>
                                                <th width="35%">Vendeur</th>
                                                <th width="20%" class="summary-money">
                                                    Chiffre d'Affaires
                                                </th>
                                                <th width="10%">
                                                    Eligible
                                                </th>
                                                <th width="15%" class="summary-money">
                                                    Commission
                                                </th>

                                            </tr>

                                        </thead>

                                        <tbody>

                                            <t t-set="period_ht" t-value="0"/>
                                            <t t-set="period_commission" t-value="0"/>

                                            <t t-foreach="weekly_customer_summary.items()"
                                            t-as="week">

                                                <t t-set="week_ht" t-value="0"/>
                                                <t t-set="week_commission" t-value="0"/>

                                                <tr style="
                                                    background:#dbeafe;
                                                    font-weight:bold;
                                                    font-size:13px;
                                                ">

                                                    <td colspan="5">

                                                        <span t-esc="week[0]"/>

                                                    </td>

                                                </tr>

                                                <t t-foreach="week[1].items()"
                                                t-as="customer">

                                                    <tr>

                                                        <td></td>

                                                        <td style="padding-left:15px;">
                                                            <span t-esc="customer[0]"/>
                                                        </td>

                                                        <td class="summary-money">

                                                            <span t-esc="'{:,.0f}'.format(
                                                                customer[1]['ca_ht']
                                                            ).replace(',', ' ')"/>

                                                            FCFA

                                                        </td>

                                                        <td style="
                                                            text-align:center;
                                                            font-weight:bold;
                                                        ">

                                                            <span t-if="customer[1]['commission'] > 0">
                                                                ✓
                                                            </span>

                                                            <span t-if="customer[1]['commission'] == 0">
                                                                -
                                                            </span>

                                                        </td>

                                                        <td class="summary-money">

                                                            <span t-esc="'{:,.0f}'.format(
                                                                customer[1]['commission']
                                                            ).replace(',', ' ')"/>

                                                            FCFA

                                                        </td>

                                                    </tr>

                                                    <t t-set="week_ht"
                                                    t-value="week_ht + customer[1]['ca_ht']"/>

                                                    <t t-set="week_commission"
                                                    t-value="week_commission + customer[1]['commission']"/>

                                                </t>

                                                <tr style="
                                                    background:#f8fafc;
                                                    font-weight:bold;
                                                    border-top:2px solid #94a3b8;
                                                ">

                                                    <td></td>

                                                    <td style="
                                                        font-size:14px;
                                                        color:#334155;
                                                    ">
                                                        TOTAL SEMAINE
                                                    </td>

                                                    <td class="summary-money">

                                                        <span t-esc="'{:,.0f}'.format(
                                                            week_ht
                                                        ).replace(',', ' ')"/>

                                                        FCFA

                                                    </td>

                                                    <td></td>

                                                    <td class="summary-money"
                                                        style="
                                                            font-size:15px;
                                                            font-weight:800;
                                                        ">

                                                        <span t-esc="'{:,.0f}'.format(
                                                            week_commission
                                                        ).replace(',', ' ')"/>

                                                        FCFA

                                                    </td>

                                                </tr>

                                            </t>

                                            <tr style="
                                                background:#1f2937;
                                                color:white;
                                                font-weight:bold;
                                            ">

                                                <td colspan="2"
                                                    style="font-size:16px;">

                                                    VENTES TOTALES DE LA PÉRIODE

                                                </td>

                                                <td class="summary-money"
                                                    style="
                                                        font-size:18px;
                                                        font-weight:900;
                                                        color:white;
                                                    ">

                                                    <span t-esc="'{:,.0f}'.format(
                                                        grand_total_ht
                                                    ).replace(',', ' ')"/>

                                                    FCFA

                                                </td>

                                                <td></td>

                                                <td class="summary-money"
                                                    style="
                                                        font-size:22px;
                                                        font-weight:900;
                                                        color:#4ade80;
                                                    ">

                                                    <span t-esc="'{:,.0f}'.format(
                                                        total_commission
                                                    ).replace(',', ' ')"/>

                                                    FCFA

                                                </td>

                                            </tr>

                                        </tbody>

                                    </table>

                                </td>

                                <!-- COLONNE DE DROITE -->

                                <td style="
                                    width:28%;
                                    vertical-align:top;
                                ">

                                    <!-- RECAP -->

                                    <table class="summary-table"
                                        style="
                                                width:100%;
                                                margin-bottom:10px;
                                        ">

                                        <tr>
                                            <td colspan="2"
                                                style="
                                                    text-align:center;
                                                    font-weight:bold;
                                                    background:#e9ecef;
                                                ">
                                                RÉCAPITULATIF
                                            </td>
                                        </tr>

                                        <tr>
                                            <td>Vendeurs</td>
                                            <td class="summary-money">
                                                <span t-esc="customer_count"/>
                                            </td>
                                        </tr>

                                        <tr>
                                            <td>Commandes</td>
                                            <td class="summary-money">
                                                <span t-esc="order_count"/>
                                            </td>
                                        </tr>

                                        <tr>
                                            <td>Chiffre d'Affaire Total</td>
                                            <td class="summary-money">
                                                <span t-esc="'{:,.0f}'.format(grand_total_ht).replace(',', ' ')"/>
                                            </td>
                                        </tr>

                                        <tr>
                                            <td>Commissions</td>
                                            <td class="summary-money">
                                                <strong>
                                                    <span t-esc="'{:,.0f}'.format(total_commission).replace(',', ' ')"/>
                                                </strong>
                                            </td>
                                        </tr>

                                    </table>

                                    <!-- TOP VENDEURS -->

                                    <table class="summary-table"
                                        style="
                                                width:100%;
                                                margin-bottom:10px;
                                        ">

                                        <tr>
                                            <td colspan="2"
                                                style="
                                                    text-align:center;
                                                    font-weight:bold;
                                                    background:#e9ecef;
                                                ">
                                                TOP 5 VENDEURS
                                            </td>
                                        </tr>

                                        <tr t-foreach="top_sellers"
                                            t-as="client">

                                            <td>
                                                <span t-esc="client[0]"/>
                                            </td>

                                            <td class="summary-money">
                                                <span t-esc="'{:,.0f}'.format(client[1]['ca_ht']).replace(',', ' ')"/>
                                            </td>

                                        </tr>

                                    </table>

                                    <!-- TOP COMMISSIONS -->

                                    <table class="summary-table"
                                        style="
                                                width:100%;
                                                margin-bottom:10px;
                                        ">

                                        <tr>
                                            <td colspan="2"
                                                style="
                                                    text-align:center;
                                                    font-weight:bold;
                                                    background:#e9ecef;
                                                ">
                                                TOP COMMISSIONS
                                            </td>
                                        </tr>

                                        <tr t-foreach="top_commissions"
                                            t-as="client">

                                            <td>
                                                <span t-esc="client[0]"/>
                                            </td>

                                            <td class="summary-money">
                                                <span t-esc="'{:,.0f}'.format(client[1]['commission']).replace(',', ' ')"/>
                                            </td>

                                        </tr>

                                    </table>


                                    <!-- A PAYER -->

                                    <table style="
                                        width:100%;
                                        border:2px solid #000;
                                    ">

                                        <tr>

                                            <td style="
                                                text-align:center;
                                                padding:15px;
                                            ">

                                                <div style="
                                                    font-size:12px;
                                                    font-weight:bold;
                                                ">
                                                    COMMISSIONS À PAYER
                                                </div>

                                                <div style="
                                                    font-size:26px;
                                                    font-weight:900;
                                                ">

                                                    <span t-esc="'{:,.0f}'.format(
                                                        total_commission
                                                    ).replace(',', ' ')"/>

                                                    FCFA

                                                </div>

                                            </td>

                                        </tr>

                                    </table>

                                </td>

                            </tr>

                        </table>


                        <div class="section-title">
                            SYNTHÈSE PAR ARTICLE
                        </div>

                            <table class="summary-report">

                                <thead>

                                    <tr>

                                        <th>Article</th>
                                        <th>Quantité Vendue</th>
                                        <th>CA HT</th>

                                    </tr>

                                </thead>

                                <tbody>

                                    <tr
                                        t-foreach="product_summary.items()"
                                        t-as="product">

                                        <td>
                                            <span t-esc="product[0]"/>
                                        </td>

                                        <td class="summary-qty">
                                            <span t-esc="product[1]['qty']"/>
                                        </td>

                                        <td class="summary-money">
                                            <span t-esc="'{:,.0f} FCFA'.format(
                                                product[1]['ca_ht']
                                            ).replace(',', ' ')"/>
                                        </td>

                                    </tr>

                                </tbody>

                            </table>

                        <hr style="margin-top:25px; font-size:16px"/>
                        <table class="signature-table">

                            <tr>

                                <td>

                                    Établi par

                                    <div class="signature-line">
                                        ________________________________
                                    </div>

                                </td>

                                <td>

                                    Vérifié par

                                    <div class="signature-line">
                                        ________________________________
                                    </div>

                                </td>

                                <td>

                                    Approuvé par

                                    <div class="signature-line">
                                        ________________________________
                                    </div>

                                </td>

                            </tr>

                        </table>

                    </div>

                </t>

            </t>

        </template>

</odoo>
